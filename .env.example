# Optional for preview/dev: the site uses bundled demo data when DATABASE_URL is omitted.
# Required for persistent production data, Drizzle commands, and seeding.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional Google Maps JavaScript API key if you later replace the iframe maps
# with the @googlemaps/js-api-loader integration.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional secure admin seed credentials
ADMIN_NAME=Gewa Realty Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
